# ─── 必填项（启动前必须设置） ─────────────────────────────
# Django SECRET_KEY：用 `openssl rand -base64 32` 生成
DJANGO_SECRET_KEY=replace-with-output-of-openssl-rand-base64-32
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# 设为 production 启用严格启动检查（默认值 development 不强制检查）
DJANGO_ENV=development

# ─── 数据库 ───────────────────────────────────────────────
DB_USER=chatinspect
DB_PASSWORD=replace-with-strong-password
DB_HOST=db
DB_PORT=5432

# ─── Redis ────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ─── LLM（质检 AI 规则使用；非 AI 规则可不填但建议填） ───
# 支持 DeepSeek / 通义千问 / OpenAI 兼容协议
LLM_PROVIDER=deepseek
LLM_API_KEY=replace-with-your-llm-api-key
LLM_API_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# 可选：切换为通义千问
# LLM_PROVIDER=qwen
# LLM_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen-plus

# 可选：切换为 OpenAI
# LLM_PROVIDER=openai
# LLM_API_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

# ─── 日报推送（可选）─────────────────────────────────────
# FEISHU_WEBHOOK=https://open.feishu.cn/open-apis/bot/v2/hook/replace-with-your-hook-id
# WEIXIN_WEBHOOK=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=replace-with-your-key

# ─── Nginx 端口 ──────────────────────────────────────────
NGINX_PORT=80